# Firebase Client Config (Required for standalone Vercel deployment)
# Get these from Firebase Console -> Project Settings -> Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional: leave blank for default Firestore database
VITE_FIREBASE_DATABASE_ID=

# Comma-separated list of admin Google account emails (must match firestore.rules)
VITE_ADMIN_EMAILS=founder@milletly.in,admin@gmail.com

# Optional WhatsApp Business number (with country code, no +)
VITE_WHATSAPP_NUMBER=919876543210
